# ---------------------------------------------------------------------------
# BSA Project Compass — browser-visible configuration
# Everything prefixed VITE_ is compiled into the public JavaScript bundle.
# NEVER place secrets, service-role keys, or AI provider keys in VITE_ vars.
# ---------------------------------------------------------------------------

# "demo" (default) runs on synthetic, browser-local data only.
# "supabase" connects to the secure backend (requires the values below).
VITE_DATA_MODE=demo

# Public Supabase project URL and anon key (safe to expose; RLS enforces access).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Auth provider for organization SSO (e.g. "azure" for Microsoft Entra ID).
VITE_IDENTITY_PROVIDER=azure

# Base path for static hosting (e.g. /bsa-project-compass/ on a sub-path).
VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# Server-side only (Supabase Edge Function secrets — set with `supabase secrets set`)
# Do NOT prefix with VITE_. Listed here for documentation only.
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic            # or "none"
# ANTHROPIC_API_KEY=               # organization-approved key only
# AI_MODEL=claude-sonnet-5-5
# AI_ALLOWED_CONFIDENTIALITY=public,internal   # classifications allowed to leave the tenant
